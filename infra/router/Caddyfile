{
	email {$ACME_EMAIL}
}

# URL versioning pipeline (docs/url-versioning-pipeline.md). Caddy handles
# the ACME HTTP-01 challenge and TLS termination automatically for
# {$DOMAIN} — no certbot/cron needed, certs persist in the caddy-data
# volume across rebuilds.
{$DOMAIN} {
	encode gzip

	# Security response headers for every version and the APIs (security
	# plan F-05, F-03; Iteration 1/2 findings 3 and 4). Set here once so the
	# frozen live-root and archive builds get them too. `defer` applies them
	# after the upstream response, which also lets the Server and Via
	# removals take out nginx's version banner and Caddy's own Via.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
		defer
	}

	# Request size limits, enforced before anything is buffered upstream
	# (security plan A-07). PDF uploads get 10 MiB plus multipart overhead;
	# everything else (pasted text is capped at 100,000 characters) 1 MB.
	@pdf_upload path /analyze-pdf
	request_body @pdf_upload {
		max_size 11MB
	}
	@not_pdf_upload not path /analyze-pdf
	request_body @not_pdf_upload {
		max_size 1MB
	}

	# The server-side site gate (security plan F-06, backend
	# src/routes/gate.js) is switched off: the site is public. To turn it
	# back on, restore this forward_auth block in front of the handles:
	#
	#   @gated not path /api/gate/*
	#   forward_auth @gated backend:3000 {
	#   	uri /api/gate/check
	#   }

	# Shared backend/developed_ai, same for every version (paths kept as-is,
	# matching how the frontend builds call them: /api/..., /analyze).
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /analyze* {
		reverse_proxy developed_ai:8000 {
			transport http {
				# Kept equal to stage2_summarizer.py's openai client
				# timeout, widened there for the same reason.
				response_header_timeout 240s
			}
		}
	}

	# Active Development (iteration in progress). Prefix stripped before
	# forwarding since frontend-dev serves its own dist root.
	handle_path /underdevelopment/* {
		reverse_proxy frontend-dev:80
	}

	# The Archive: iteration-1, retired at the iteration-2 cutover. Prefix
	# stripped before forwarding, same as /underdevelopment/ - see
	# frontend-archive in docker-compose.prod.yml for how that pre-sub-path
	# code is built to work under this prefix.
	handle_path /version1/* {
		reverse_proxy frontend-archive:80
	}

	# The Archive, part 2: iteration-2.1, retired at the iteration-3
	# cutover. Built with VITE_BASE_PATH=/version2/, so its assets and
	# routes already live under the prefix.
	handle_path /version2/* {
		reverse_proxy frontend-archive-2:80
	}

	# The LIVE Root: always the last complete iteration.
	handle {
		reverse_proxy frontend:80
	}
}
